class ContaBancaria:
    def __init__(self, titular, conta, saldo):
        self.titular = titular
        self.conta = conta
        self.saldo = saldo

    def depositar(self, valor):
        self.saldo += valor

    def sacar(self, valor):
        if valor <= self.saldo:
            self.saldo -= valor
        else:
            print("Saldo insuficiente")

    def consultar(self):
        print("Saldo:", self.saldo)

c = ContaBancaria("João", "123", 500)
c.depositar(100)
c.sacar(200)
c.consultar()


# 5
class Funcionario:
    def __init__(self, nome):
        self.nome = nome

class FuncionarioHorista(Funcionario):
    def __init__(self, nome, horas, valor):
        super().__init__(nome)
        self.horas = horas
        self.valor = valor

    def salario(self):
        print(self.nome, self.horas * self.valor)

class FuncionarioMensalista(Funcionario):
    def __init__(self, nome, salario):
        super().__init__(nome)
        self.salario_mensal = salario

    def salario(self):
        print(self.nome, self.salario_mensal)

f1 = FuncionarioHorista("Carlos", 160, 20)
f2 = FuncionarioMensalista("Maria", 3000)

f1.salario()
f2.salario()
