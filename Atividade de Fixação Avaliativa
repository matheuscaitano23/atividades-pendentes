# 3
def contar(lista):
    pares = 0
    impares = 0
    positivos = 0
    negativos = 0

    for n in lista:
        if type(n) != int:
            print("Entrada inválida")
            continue

        if n % 2 == 0:
            pares += 1
        else:
            impares += 1

        if n >= 0:
            positivos += 1
        else:
            negativos += 1

    print("Pares:", pares)
    print("Ímpares:", impares)
    print("Positivos:", positivos)
    print("Negativos:", negativos)

contar([1, 2, -3, 4, -5, 6])


