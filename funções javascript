// 9

let maior18 = 0;
let menor18 = 0;
let idade2;

do {
    idade2 = Number(prompt("Digite uma idade (0 para parar):"));

    if (idade2 >= 18) {
        maior18++;
    } else if (idade2 > 0) {
        menor18++;
    }

} while (idade2 != 0);

alert("Maiores: " + maior18 + "\nMenores: " + menor18);
document.write("Maiores: " + maior18 + "<br>Menores: " + menor18);
console.log("Maiores:", maior18, "Menores:", menor18);


// 10

function imc(p, a) {
    return p / (a * a);
}

let nome2 = prompt("Nome:");
let idade3 = prompt("Idade:");
let peso = Number(prompt("Peso:"));
let altura = Number(prompt("Altura:"));

let resultadoIMC = imc(peso, altura);

alert(nome2 + " - " + idade3 + " anos - IMC: " + resultadoIMC.toFixed(2));
document.write(nome2 + " - " + idade3 + " anos - IMC: " + resultadoIMC.toFixed(2));
console.log(nome2, idade3, resultadoIMC.toFixed(2));
