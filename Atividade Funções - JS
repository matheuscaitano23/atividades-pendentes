// 2 - Salário

function calcularSalario(salario) {
    let gratificacao = salario * 0.05;
    let total = salario + gratificacao;
    let imposto = total * 0.07;

    return total - imposto;
}

let salario = parseFloat(prompt("Digite o salário-base:"));
let salarioFinal = calcularSalario(salario);

alert("Salário final: R$ " + salarioFinal.toFixed(2));
document.write("Salário final: R$ " + salarioFinal.toFixed(2) + "<br>");
console.log("Salário final: R$ " + salarioFinal.toFixed(2));


