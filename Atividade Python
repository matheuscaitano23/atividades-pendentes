# Questão 6

maior = 0
menor = 999
soma_mulheres = 0
quantidade_mulheres = 0
homens = 0

for i in range(50):
    altura = float(input("Digite a altura: "))
    sexo = input("Digite o sexo (M/F): ")

    if altura > maior:
        maior = altura

    if altura < menor:
        menor = altura

    if sexo == "F" or sexo == "f":
        soma_mulheres += altura
        quantidade_mulheres += 1
    elif sexo == "M" or sexo == "m":
        homens += 1

if quantidade_mulheres > 0:
    media_mulheres = soma_mulheres / quantidade_mulheres
else:
    media_mulheres = 0

mulheres = 50 - homens

print("Maior altura:", maior)
print("Menor altura:", menor)
print("Média de altura das mulheres:", media_mulheres)
print("Total de homens:", homens)
print("Porcentagem de homens:", (homens / 50) * 100, "%")
print("Porcentagem de mulheres:", (mulheres / 50) * 100, "%")

print()


