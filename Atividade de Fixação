# 5 - Tabuada
num = int(input("Número: "))
for i in range(1, 11):
    print(num, "x", i, "=", num * i)

# 6 - Par ou ímpar
num = int(input("Número: "))
if num % 2 == 0:
    print("Par")
else:
    print("Ímpar")

# 7 - Fatorial
num = int(input("Número: "))
fat = 1
for i in range(1, num + 1):
    fat = fat * i
print(fat)

