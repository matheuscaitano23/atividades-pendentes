function contas(x, y) {
    return [x + y, x * y, x / y, x - y];
}

let a = Number(prompt("Digite um número:"));
let b = Number(prompt("Digite outro número:"));
let r = contas(a, b);

alert(r);
document.write(r + "<br>");
console.log(r);


