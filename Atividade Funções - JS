// 5 - Operações usando funções

function somar(a, b) {
    return a + b;
}

function multiplicar(a, b) {
    return a * b;
}

function dividir(a, b) {
    return a / b;
}

function subtrair(a, b) {
    return a - b;
}

let numero1 = parseInt(prompt("Digite o primeiro número:"));
let numero2 = parseInt(prompt("Digite o segundo número:"));

let resultadoSoma = somar(numero1, numero2);
let resultadoMultiplicacao = multiplicar(numero1, numero2);
let resultadoDivisao = dividir(numero1, numero2);
let resultadoSubtracao = subtrair(numero1, numero2);

alert(
    "Soma: " + resultadoSoma +
    "\nMultiplicação: " + resultadoMultiplicacao +
    "\nDivisão: " + resultadoDivisao +
    "\nSubtração: " + resultadoSubtracao
);

document.write("Soma: " + resultadoSoma + "<br>");
document.write("Multiplicação: " + resultadoMultiplicacao + "<br>");
document.write("Divisão: " + resultadoDivisao + "<br>");
document.write("Subtração: " + resultadoSubtracao + "<br>");

console.log("Soma: " + resultadoSoma);
console.log("Multiplicação: " + resultadoMultiplicacao);
console.log("Divisão: " + resultadoDivisao);
console.log("Subtração: " + resultadoSubtracao);


