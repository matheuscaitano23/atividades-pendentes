// 9 - Maiores e menores de idade

let maiores = 0;
let menores = 0;
let idadePessoa;

do {
    idadePessoa = parseInt(prompt("Digite uma idade (0 para parar):"));

    if (idadePessoa >= 18) {
        maiores++;
    } else if (idadePessoa > 0) {
        menores++;
    }

} while (idadePessoa != 0);

alert(
    "Maiores de idade: " + maiores +
    "\nMenores de idade: " + menores
);

document.write("Maiores de idade: " + maiores + "<br>");
